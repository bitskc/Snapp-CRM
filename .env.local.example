# Environment Configuration Template
#
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored.

# Required for frontend app auth/data access
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Gemini key is NOT read by the frontend app.
# Set it as a Supabase Edge Function secret instead:
# npx supabase secrets set GEMINI_API_KEY=your_actual_google_gemini_api_key
